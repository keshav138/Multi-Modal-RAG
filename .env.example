# ─── Multi Modal RAG — environment template ────────────────────────
# Copy this file to .env and fill in real values before running.

# PostgreSQL connection string (pgvector-enabled database).
# Local dev: your machine's Postgres, e.g. postgresql://postgres:pw@localhost:5432/fieldnote
# EC2 box:   the compose-internal db service, e.g. postgresql://rag:rag@db:5432/rag
#            (Jenkins writes this automatically during deploy — nothing to do here)
DATABASE_URL=postgresql://postgres:password@localhost:5432/fieldnote

# Groq cloud API key for LLM inference
GROQ_API_KEY=gsk_your_key_here

# LLM model served by Groq
GROQ_MODEL=llama-3.3-70b-versatile

# Sentence-transformer model for text embeddings
TEXT_EMBED_MODEL=BAAI/bge-small-en-v1.5

# SigLIP model for image embeddings
IMAGE_EMBED_MODEL=google/siglip-base-patch16-224

# Cross-encoder model used for reranking retrieval results
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Whisper model size for speech-to-text
WHISPER_MODEL=small.en

# Directory containing cropped PDF figures (extracted server-side)
IMAGE_DIR=./data/out_images

# Where multipart uploads are staged before background ingestion
UPLOAD_DIR=./data/uploads

# Uvicorn bind address & port
HOST=0.0.0.0
PORT=8000
